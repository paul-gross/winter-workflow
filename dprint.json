{
  "markdown": {
    "textWrap": "always",
    "lineWidth": 120,
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "unorderedListKind": "dashes"
  },
  // The agent-frontmatter lint's deliberate-violation fixtures are inputs to
  // assertions, not prose — reformatting one rewrites the shape its test pins.
  "excludes": ["tests/fixtures/**"],
  "plugins": ["https://plugins.dprint.dev/markdown-0.22.1.wasm"]
}
